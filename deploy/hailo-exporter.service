[Unit]
Description=Hailo Alert Exporter to Prometheus
Documentation=https://github.com/sikienzl/TradingBot/blob/main/docs/hybrid_cluster.md
After=network.target trading-bot.service
PartOf=trading-bot.service
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=simple
User=root
WorkingDirectory=/opt/trading_2
Environment="PATH=/opt/trading_2/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/usr/local/lib/python3.13/dist-packages:/opt/trading_2"
EnvironmentFile=-/opt/trading_2/.env
Environment="HAILO_EXPORTER_PORT=9205"
ExecStart=/usr/bin/python3 /opt/trading_2/src/hailo/alert_exporter.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hailo-exporter
PrivateTmp=no
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/tmp /var/log

# Resource limits
MemoryLimit=64M
CPUQuota=25%
TimeoutStopSec=15

[Install]
WantedBy=trading-bot.service
