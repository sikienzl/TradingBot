[Unit]
Description=AutoResearch periodic runner for TradingBot
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/trading_2
# Load environment file (project .env) from deployed path
EnvironmentFile=/opt/trading_2/.env
# Ensure python path is explicit; use project path
ExecStart=/usr/bin/env bash -lc "source /opt/trading_2/.env && /usr/bin/python3 -m src.autoresearch.cli --strategy example-search --news /opt/trading_2/data/sample_news.json"
User=siegfried

[Install]
WantedBy=multi-user.target
