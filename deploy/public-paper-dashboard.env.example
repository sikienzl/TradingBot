# Copy to a private dashboard.env file and replace every example value.
# Use private CIDR ranges only; separate networks with commas.
DASHBOARD_ALLOWED_NETWORKS=
DASHBOARD_USERNAME=paper-viewer
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Bind only to a reachable host interface address.
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_PORT=8443
DASHBOARD_TLS_CERT=/tls/server.crt
DASHBOARD_TLS_KEY=/tls/server.key

DASHBOARD_DATA_DIR=/data
DASHBOARD_REPORT_FILE=/reports/latest.json
DASHBOARD_LOG_FILE=/data/trading_bot.log
