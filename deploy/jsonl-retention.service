[Unit]
Description=Trading Bot – Prune the append-only JSONL stores to the retention policy
# No network and no exchange access: this unit only rewrites two local files.
# It must not start before the directories the installer created exist.
After=local-fs.target

[Service]
Type=oneshot
User=trading
Group=trading
WorkingDirectory=/opt/trading_2
EnvironmentFile=/opt/trading_2/.env
Environment=PYTHONPATH=/opt/trading_2
# Relative store paths in .env resolve against WorkingDirectory, which is why
# the deployment root is set explicitly here.
Environment=TRADING_JSONL_RETENTION_REPORT=/opt/trading_2/results/jsonl_retention/latest_status.env
ExecStart=/opt/trading_2/.venv/bin/python -m scripts.prune_jsonl_stores
# 1 means "a store could not be pruned" and 2 means "retention is switched
# off"; both are operator findings, not unit failures. The alerts read the
# marker, so keeping the unit clean separates "the timer is broken" from
# "the store is still growing".
SuccessExitStatus=0 1 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/trading_2/data /opt/trading_2/results/scorecards /opt/trading_2/results/jsonl_retention
