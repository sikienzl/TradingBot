# Optional. Keep exchange credentials out of this health-check environment.
# Set this only when a Hailo service is configured for this bot host.
HAILO_HEALTH_URL=http://127.0.0.1:18001/health

# Optional. Set this only on a host that runs the market recorder, so the
# staleness alert does not fire for a deployment that never collects market data.
# TRADING_MARKET_DATA_DIR=/mnt/nvme_data/trading-market-recorder/data

# Optional. Scheduled-task status markers to export as exit-code and last-run
# gauges, as name=path pairs. The unit already points at the daily dry-run
# review, weekly scorecard, weekly tuning and JSONL store retention markers; add
# other wrappers here when they run on this host.
# TRADING_TASK_STATUS_FILES=daily_review=/opt/trading_2/results/daily_review/latest_status.env,scorecard=/opt/trading_2/results/scorecards/latest_status.env,weekly_tuning=/opt/trading_2/results/tuning/latest_status.env,jsonl_retention=/opt/trading_2/results/jsonl_retention/latest_status.env

# Optional. Comma-separated mount points to export disk capacity for. Defaults
# to TRADING_DATA_DIR, which is the volume the bot writes journal and state to.
# TRADING_DISK_PATHS=/opt/trading_2,/mnt/nvme_data

# Optional. Analytics PostgreSQL URL (the same ANALYTICS_DB_URL the bot uses).
# When set, the exporter probes the database size; psycopg must be installed on
# this host. Leave unset on a single-node Raspberry Pi release.
# ANALYTICS_DB_URL=postgresql://trading@127.0.0.1:5432/trading_analytics

# Optional. Overrides for the live-trading scorecard gate gauges. The defaults
# already match a standard deployment: the verdict markers are read from
# results/scorecards/latest_status.json and latest_status.env relative to the
# unit WorkingDirectory, and DRY_RUN from the bot deployment .env set by the
# unit. Only the run mode is read, never a credential.
# SCORECARD_STATUS_JSON=/opt/trading_2/results/scorecards/latest_status.json
# SCORECARD_STATUS_ENV=/opt/trading_2/results/scorecards/latest_status.env
# TRADING_DEPLOYMENT_ENV_FILE=/opt/trading_2/.env

# Optional. Per-decision tabular inference backend counters written by the bot
# (src.inference_decision_stats.py). The unit already points at the default
# location; override it here only when the bot writes the counters elsewhere.
# The exporter only reads this file - it never writes a counter itself.
# TRADING_INFERENCE_STATS_FILE=/opt/trading_2/results/inference/backend_stats.json

# Optional. Root of the immutable paired CPU/Hailo model releases that
# scripts/manage_model_release.py promotes on this host. When set, the exporter
# publishes which release the active link points at, whether every artifact
# still matches its manifest checksum, and how old the release is - so a
# swapped, dangling or edited release is visible in monitoring instead of only
# in a wrong-looking decision. Leave unset on a host that has no paired
# releases: then no release gauge is published and the release alerts stay off.
# TRADING_MODEL_RELEASE_ROOT=/opt/trading-models
