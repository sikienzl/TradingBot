# Optional. Keep exchange credentials out of this health-check environment.
# Set this only when a Hailo service is configured for this bot host.
HAILO_HEALTH_URL=http://127.0.0.1:18001/health

# Optional. Set this only on a host that runs the market recorder, so the
# staleness alert does not fire for a deployment that never collects market data.
# TRADING_MARKET_DATA_DIR=/mnt/nvme_data/trading-market-recorder/data

# Optional. Scheduled-task status markers to export as exit-code and last-run
# gauges, as name=path pairs. The unit already points at the daily dry-run
# review marker; add other wrappers here when they run on this host.
# TRADING_TASK_STATUS_FILES=daily_review=/opt/trading_2/results/daily_review/latest_status.env

# Optional. Comma-separated mount points to export disk capacity for. Defaults
# to TRADING_DATA_DIR, which is the volume the bot writes journal and state to.
# TRADING_DISK_PATHS=/opt/trading_2,/mnt/nvme_data

# Optional. Analytics PostgreSQL URL (the same ANALYTICS_DB_URL the bot uses).
# When set, the exporter probes the database size; psycopg must be installed on
# this host. Leave unset on a single-node Raspberry Pi release.
# ANALYTICS_DB_URL=postgresql://trading@127.0.0.1:5432/trading_analytics
