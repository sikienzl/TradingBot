# Copy to a private location and set HAILO_API_TOKEN to the service token.
DRY_RUN=true
SIMULATE_DATA=true
SIMULATION_INITIAL_BALANCE_FROM_KRAKEN=false
SIMULATION_REGIME=mixed
USE_ML_MODEL=false
USE_TABULAR_MODEL=true
TABULAR_MODEL_BACKEND=hailo
HAILO_SERVICE_URL=http://127.0.0.1:18001
HAILO_API_TOKEN=
HAILO_TIMEOUT_SECONDS=3
AUTO_TUNE_TABULAR_CONFIDENCE=false
ANALYTICS_DB_ENABLED=false
PERFORMANCE_LOG_ENABLED=true
PERFORMANCE_LOG_FILE=/data/trade_journal.csv
CHECK_INTERVAL=60
