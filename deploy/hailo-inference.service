[Unit]
Description=Trading Bot Hailo-8 Inference Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/trading_hailo
EnvironmentFile=/etc/trading-hailo.env
Environment=PYTHONPATH=/opt/trading_hailo:/usr/lib/python3/dist-packages
ExecStart=/opt/trading_hailo/.venv/bin/python -m src.hailo_service
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/trading_hailo/model

[Install]
WantedBy=multi-user.target
