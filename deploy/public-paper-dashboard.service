[Unit]
Description=Read-only authenticated paper trading dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/sg docker -c "/usr/bin/docker run --rm --name trading-paper-dashboard --network host --cap-drop=ALL --security-opt=no-new-privileges --read-only --tmpfs /tmp:rw,noexec,nosuid,size=16m --pids-limit=64 --memory=256m --env-file %h/trading-paper-dashboard/dashboard.env --mount type=bind,src=%h/trading-hailo-public-paper/data,dst=/data,readonly --mount type=bind,src=%h/trading-hailo-public-paper/reports,dst=/reports,readonly --mount type=bind,src=%h/trading-paper-dashboard/tls,dst=/tls,readonly trading-paper-dashboard:local"
ExecStop=/usr/bin/sg docker -c "/usr/bin/docker stop --time 15 trading-paper-dashboard"
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
