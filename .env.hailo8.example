# ============================================================================
# HAILO-8 + K3s HYBRID TRADING BOT CONFIGURATION
# ============================================================================
# Copy this to .env.hailo8 and customize for your Hailo-8 + K3s cluster setup

# ---------------------------------------------------------------------------
# HYBRID ARCHITECTURE SETTINGS
# ---------------------------------------------------------------------------
HYBRID_MODE=true
HAILO_ENABLED=true
DEPLOYMENT_PLATFORM=k3s
NODE_ROLE=hybrid  # Options: hailo_edge (Node 2), cloud_strategist (Node 1), hybrid (both)

# ---------------------------------------------------------------------------
# KRAKEN WEBSOCKET V2 API (replaces CCXT polling)
# ---------------------------------------------------------------------------
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET_KEY=your_kraken_secret_key_here
KRAKEN_WEBSOCKET_V2_ENABLED=true
KRAKEN_WS_RECONNECT_TIMEOUT=30
KRAKEN_TICK_BUFFER_SIZE=500  # Local buffer for tick storage on NVMe

# ---------------------------------------------------------------------------
# HAILO-8 EDGE INFERENCE (Node 2 - Worker with Hailo-8 Module)
# ---------------------------------------------------------------------------
# High-Frequency Filtering: Anomaly Detection on 24/7 local loop
HAILO8_ENABLED=true
# Cluster-only mode (without physical Hailo module yet):
# keep HAILO8_ENABLED=true so pipeline stays active, but force CPU runtime.
HAILO8_FORCE_CPU=true
HAILO8_MODEL_PATH=/models/hailo/timeseries_transformer.onnx
HAILO8_BATCH_SIZE=32
HAILO8_INFERENCE_INTERVAL_MS=100  # Inference every 100ms (26 TOPS = capable)
HAILO8_ANOMALY_THRESHOLD=85  # Score 0-100: trigger GPT-5 when > 85
HAILO8_WINDOW_SIZE=100  # Sliding window of recent ticks for detection
HAILO8_METRICS_PORT=9201  # Prometheus metrics for Hailo worker

# Local NVMe SSD for tick storage (Node 2)
HAILO8_LOCAL_TICK_PATH=/mnt/nvme/trading_ticks
HAILO8_LOCAL_TICK_RETENTION_DAYS=7  # Keep rolling 7 days of ticks

# ---------------------------------------------------------------------------
# TIME-SERIES TRANSFORMER MODEL (Training & Inference)
# ---------------------------------------------------------------------------
# Model for Hailo-8 optimization (ONNX export)
TIMESERIES_TRANSFORMER_ENABLED=true
TIMESERIES_MODEL_PATH=/models/hailo/timeseries_transformer_state.pt
TIMESERIES_ONNX_EXPORT_PATH=/models/hailo/timeseries_transformer.onnx
TIMESERIES_SEQ_LENGTH=60  # Sequence length for transformer
TIMESERIES_HIDDEN_DIM=128
TIMESERIES_N_LAYERS=4
TIMESERIES_N_HEADS=8
TIMESERIES_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# GPT-5 CHIEF STRATEGIST (Cloud Integration)
# ---------------------------------------------------------------------------
# Triggered ONLY when Hailo-8 detects anomaly (> threshold)
GPT5_ENABLED=true
GPT5_API_ENDPOINT=https://api.anthropic.com/v1/messages  # Or Mammouth AI
GPT5_API_KEY=your_gpt5_api_key_here
GPT5_MODEL=gpt-5.4-nano  # Or claude-opus, etc.
GPT5_MAX_CALLS_PER_DAY=100  # Rate limit
GPT5_MAX_SPEND_PER_MONTH_USD=500
GPT5_CONTEXT_WINDOW_SIZE=8000  # Token budget per call

# Retry & timeout settings
GPT5_REQUEST_TIMEOUT_SEC=30
GPT5_RETRY_COUNT=3
GPT5_RETRY_BACKOFF_SEC=5

# Logging
GPT5_LOG_LEVEL=info
GPT5_SHADOW_MODE=false  # Set true to test without executing trades

# Optional: reuse trading_bot AI co-pilot with Hailo preselection gate
AI_COPILOT_ENABLED=true
AI_COPILOT_HAILO_GATE_ENABLED=true
AI_COPILOT_HAILO_ALERTS_FILE=/tmp/hailo_alerts.jsonl
AI_COPILOT_HAILO_MIN_SCORE=85
AI_COPILOT_HAILO_MIN_CONFIDENCE=0.60
AI_COPILOT_HAILO_MAX_ALERT_AGE_SECONDS=900
AI_COPILOT_HAILO_REQUIRED_ALERTS=1
AI_COPILOT_HAILO_MAX_LINES_SCAN=400

# ---------------------------------------------------------------------------
# HYBRID DECISION GATING
# ---------------------------------------------------------------------------
# Orchestration of Hailo-8 filter → GPT-5 strategist
HYBRID_GATE_ENABLED=true
HYBRID_GATE_USE_HISTORICAL_DATA=true  # Use last 100 ticks as context
HYBRID_GATE_EMIT_METRICS=true

# When to skip GPT-5 call even if Hailo triggers:
HYBRID_GATE_SKIP_AFTER_DAILY_CALLS=50  # Skip if already called 50x today
HYBRID_GATE_SKIP_IF_LOW_CONFIDENCE=true
HYBRID_GATE_MIN_CONFIDENCE_FOR_EXECUTION=0.6

# ---------------------------------------------------------------------------
# K3S DEPLOYMENT
# ---------------------------------------------------------------------------
K3S_CLUSTER_ENDPOINT=192.168.1.10:6443  # Master node IP
K3S_CLUSTER_TOKEN=your_k3s_token_here
K3S_NAMESPACE=trading-bot
K3S_HAILO_NODE_NAME=trading-role=hailo-worker  # Worker selector label
K3S_CLOUD_NODE_NAME=trading-role=master-ssd  # Master selector label

# Inter-pod communication
K3S_RABBITMQ_BROKER_URL=amqp://rabbitmq:5672  # Optional: task queue
K3S_REDIS_BROKER_URL=redis://redis:6379  # Optional: caching

# ---------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# ---------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_SCRAPE_INTERVAL=30s

# Metrics ports:
# - Hailo worker: 9201
# - Cloud strategist: 9202
# - Main trading-bot: 9200 (existing)

LOKI_ENABLED=false  # Set true to ship logs to Loki
LOKI_ENDPOINT=http://loki:3100

# ---------------------------------------------------------------------------
# TRADING CORE (inherited from base config, tunable for hybrid)
# ---------------------------------------------------------------------------
EXCHANGE=kraken
BASE_CURRENCY=EUR
DRY_RUN=false
SIMULATE_DATA=false

# Entry thresholds (conservative for high-frequency scenarios)
MIN_ENTRY_SCORE=65
FALLBACK_MIN_SCORE=50
TABULAR_MIN_CONFIDENCE=0.5
MAX_OPEN_TRADES=5

# Risk guardrails
MAX_DAILY_LOSS_PCT=3.0
MAX_BUYS_PER_HOUR=4
LOSS_STREAK_PAUSE=3

# Exit strategy
STOP_LOSS_PCT=4.0
TAKE_PROFIT_PCT=8.0
MAX_HOLD_SECONDS=300  # Shorter hold for HFT-filter regime

# ---------------------------------------------------------------------------
# POSTGRES ANALYTICS (optional)
# ---------------------------------------------------------------------------
ANALYTICS_DB_ENABLED=true
ANALYTICS_DB_HOST=postgres-analytics
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=appdb
ANALYTICS_DB_USER=trading_db
ANALYTICS_DB_PASSWORD=secure_password_here
ANALYTICS_DB_SSLMODE=disable
ANALYTICS_DB_SCHEMA=trading_analytics
ANALYTICS_DB_CONNECT_TIMEOUT_SECONDS=5
ANALYTICS_DB_SNAPSHOT_EVERY=1

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json  # Options: json, text
LOG_FILE=/var/log/trading-bot/hybrid.log
LOG_RETENTION_DAYS=30
