[Unit]
Description=Trading Bot PnL Metrics Exporter for Prometheus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/opt/trading_2
Environment=PYTHONPATH=/opt/trading_2
ExecStart=/opt/trading_2/.venv/bin/python3 -m src.pnl_exporter
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
